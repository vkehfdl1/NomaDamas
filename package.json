{
  "name": "slack-shoot",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "bin": {
    "slack-shoot": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "AGENTS.md",
    "docs",
    "skills"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/fix-cli-mode.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "qa:live": "node scripts/qa-live.mjs"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "@slack/web-api": "^7.10.0",
    "commander": "^14.0.2",
    "ky": "^1.14.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  },
  "engines": {
    "node": ">=20"
  }
}
